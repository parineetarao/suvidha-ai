# Member 3 (Application, Voice & Deployment) — Phase 1 infra config
# Shared file: everyone appends their own vars below, don't reorder.

# App identity / runtime mode
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Postgres — app/config.py builds DATABASE_URL from these at runtime.
# POSTGRES_HOST is "localhost" here for running the app on your own machine;
# docker-compose.yml overrides it to "postgres" for the backend container.
POSTGRES_USER=suvidha
POSTGRES_PASSWORD=changeme
POSTGRES_DB=suvidha_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000
